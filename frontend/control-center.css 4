th:100%;font-size:15px;margin:2px 0 30px}.message{padding:11px 13px;border-radius:12px;background:#153b2a;color:#9df0bd;margin-bottom:14px;font-size:13px}.message.error{background:#4a2026;color:#ffc1c7}.premium{border-color:#6a5620}@media(max-width:650px){.grid{grid-template-columns:1fr}.group-card{align-items:flex-start}.group-card .primary{display:none}.page{padding:10px}.section-card{padding:14px;border-radius:17px}.section-title h2{font-size:17px}}\n
/* RACAAL v2: accessible, eye-friendly mobile styling */
:root{color-scheme:dark;--racaal-bg:#101827;--racaal-card:#182538;--racaal-border:#30445d;--racaal-text:#edf3f8;--racaal-muted:#a9b8c9;--racaal-accent:#82c7b5;--racaal-gold:#e2c078}
body{background:linear-gradient(180deg,#101827 0%,#111e2d 100%);color:var(--racaal-text);line-height:1.5}
.topbar{background:rgba(19,32,49,.97);border-color:var(--racaal-border);padding:14px max(16px,env(safe-area-inset-left))}
.section-card,.group-card{background:var(--racaal-card);border-color:var(--racaal-border);box-shadow:0 6px 20px rgba(0,0,0,.12)}
.section-title p,.helper-text{color:var(--racaal-muted);line-height:1.55}
input:not([type=checkbox]),select,textarea{background:#111d2c;border-color:#40546b;color:#f3f6fa;min-height:44px}
input:focus,select:focus,textarea:focus,button:focus-visible{outline:2px solid var(--racaal-accent);outline-offset:2px}
button{min-height:44px;cursor:pointer;touch-action:manipulation}
.primary,.save-bottom{background:var(--racaal-accent);color:#10231f}
.secondary{border:1px solid #52677d;border-radius:12px;padding:10px 14px;background:#24354a;color:#f2f6fa}
.toggle{gap:12px;line-height:1.4;color:#e1e9f2;background:#142235;border-color:#30445d}
.toggle input{flex:0 0 20px;accent-color:var(--racaal-accent)}
.premium{border-color:#8c7546}
.bible-module{border-color:#4d8278}
.bible-module h2{color:#c2eadf}
.bible-settings{margin-top:14px}
.action-row{display:flex;flex-wrap:wrap;gap:10px;margin-top:14px}
.helper-text{font-size:12px;margin-top:12px}
@media(max-width:650px){.page{padding:10px 10px calc(22px + env(safe-area-inset-bottom))}.section-card,.group-card{padding:14px}.section-title h2{font-size:17px}.action-row button{width:100%}.group-card{flex-wrap:wrap}.group-card .primary{display:inline-flex}.grid{gap:10px}label{font-size:13px}}
